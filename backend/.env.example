# ============================================================
# .env.example — Modèle des variables d'environnement
# ============================================================
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir les valeurs dans .env
#   3. NE JAMAIS commiter .env sur Git !
# ============================================================

# Port d'écoute du serveur Express
PORT=5000

# URI de connexion MongoDB
# Option 1 — MongoDB local (à installer sur ta machine)
MONGO_URI=mongodb://localhost:27017/campus_fix

# Option 2 — MongoDB Atlas (cloud, gratuit)
# Créer un compte sur https://www.mongodb.com/cloud/atlas
# puis remplacer par ton URI Atlas :
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_fix
